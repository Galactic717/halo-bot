{
  "name": "halo-bot",
  "productName": "Halo Bot",
  "version": "0.1.0",
  "description": "Halo Bot — AI teammates you can give real work to, running on your own Windows machine",
  "private": true,
  "main": "dist/main/main.cjs",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:native && npm run build:main && npm run build:renderer",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test host/halo.test.ts host/box.test.ts host/provider.test.ts",
    "verify": "node scripts/verify.mts",
    "icon": "node scripts/make-icon.mjs",
    "icons:brands": "node scripts/make-brand-icons.mjs",
    "package": "node scripts/build-native.mjs --strict && npm run build:main && npm run build:renderer && electron-builder --win --x64",
    "build:native": "node scripts/build-native.mjs",
    "icons:android": "node scripts/make-android-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "simple-icons": "^16.28.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "build": {
    "appId": "com.halo.bot",
    "productName": "Halo Bot",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Halo Bot"
    },
    "extraResources": [
      {
        "from": "build/halo-box.exe",
        "to": "halo-box.exe"
      }
    ]
  }
}
